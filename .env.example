# Local development defaults. Copy to .env to override; never commit real secrets.
DATABASE_URL=postgres://myfit:myfit_local_dev@localhost:5433/myfit?sslmode=disable
API_ADDR=127.0.0.1:8080
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Enable secure cookies behind HTTPS, and use a private PostgreSQL connection with TLS
# before deploying. The included Vite server is for local development.
