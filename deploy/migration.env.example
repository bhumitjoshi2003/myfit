# Docker --env-file syntax: raw URL values without surrounding quotes. URL-encode passwords.
# Separate file, available only to an explicitly approved one-shot migration command.
# Never include this DDL credential in the long-running API container.
APP_ENV=production
APP_ORIGIN=https://myfit.edunexify.co.in
COOKIE_SECURE=true
AUTO_MIGRATE=false
DATABASE_URL=postgresql://MYFIT_RUNTIME_ROLE:URL_ENCODED_PASSWORD@ep-REPLACE-pooler.REGION.aws.neon.tech/myfit?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://MYFIT_MIGRATION_ROLE:URL_ENCODED_PASSWORD@ep-REPLACE.REGION.aws.neon.tech/myfit?sslmode=verify-full&connect_timeout=10
DB_MAX_CONNS=1
GOMEMLIMIT=64MiB
GOMAXPROCS=1
