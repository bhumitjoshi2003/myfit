# Copy to /opt/myfit/shared/production.env; chmod 600. Never commit the real file.
# Compose env syntax, NOT shell syntax. Quote URLs if they contain $ or #.
MYFIT_IMAGE=registry.example.com/myfit-api:REPLACE_WITH_RELEASE_TAG
# Pooled runtime endpoint, dedicated MyFit database and runtime-only role.
DATABASE_URL='postgresql://MYFIT_RUNTIME_ROLE:URL_ENCODED_PASSWORD@ep-REPLACE-pooler.REGION.aws.neon.tech/myfit?sslmode=verify-full&connect_timeout=10'
MYFIT_API_PORT=18080
MYFIT_MEMORY_LIMIT=96m
MYFIT_GOMEMLIMIT=64MiB
MYFIT_CPU_LIMIT=0.50
DB_MAX_CONNS=4
DB_MAX_IDLE_TIME=5m
DB_MAX_LIFETIME=30m
DB_CONNECT_TIMEOUT=10s
